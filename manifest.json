{
  "manifest_version": 3,
  "name": "PokeTaka Alert",
  "version": "1.1",
  "permissions": ["notifications", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PokeTaka Alert",
    "default_icon": { "128": "icon128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://TU-SITIO-WEB/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "128": "icon128.png" }
}
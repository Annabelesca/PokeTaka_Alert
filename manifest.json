
{
  "manifest_version": 3,
  "name": "PokeTaka Favored Type Alert",
  "version": "1.0.0",
  "description": "Detecta cambios en el Favored Type de PokeTaka.",
  "permissions": ["notifications"],
  "content_scripts": [
    {
      "matches": ["https://poketaka.fr/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
